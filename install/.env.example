# install/.env.example - Variables para podman-compose (contenedores InfluxDB + Redis)
# Copiar a ${PROJECT_DIR}/.env y completar con un token real.
# podman-compose interpola ${...} del archivo .env del directorio del proyecto.
#
#   cp install/.env.example .env
#
# Este token es SOLO para el bootstrap del contenedor InfluxDB (variable
# DOCKER_INFLUXDB_INIT_ADMIN_TOKEN). El token de la aplicacion va en .env.ia
# (INFLUXDB_TOKEN) y se genera/apunta en el paso de setup de InfluxDB.
INFLUXDB_ADMIN_TOKEN=CHANGEME_influxdb_admin_token

# Opcional: si quieres exponer la UI de InfluxDB fuera de localhost, cambia
# el binding en compose.yml (por defecto 127.0.0.1:8086).