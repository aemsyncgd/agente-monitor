[Unit]
Description=Agente Monitor - Agente LLM (Ollama / OpenRouter / Anthropic)
Documentation=file://@PROJECT_DIR@/README_AGENT.md
After=influxdb-ia.service
Wants=influxdb-ia.service

[Service]
Type=simple
WorkingDirectory=@PROJECT_DIR@
Environment=CONFIG_PATH=config/config_ia.yaml
EnvironmentFile=@PROJECT_DIR@/.env.ia
ExecStart=@PROJECT_DIR@/venv/bin/python3 -m src.ai.llm_agent.main
Restart=always
RestartSec=10
TimeoutStopSec=30
KillSignal=SIGTERM

# Logs
StandardOutput=append:@PROJECT_DIR@/logs/llm-agent.log
StandardError=append:@PROJECT_DIR@/logs/llm-agent-error.log

[Install]
WantedBy=default.target
