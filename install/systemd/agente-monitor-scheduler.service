[Unit]
Description=Agente Monitor - Scheduler (reportes, health checks, RAG reindex)
Documentation=file://@PROJECT_DIR@/README_AGENT.md
After=default.target

[Service]
Type=simple
WorkingDirectory=@PROJECT_DIR@
Environment=CONFIG_PATH=config/config_ia.yaml
EnvironmentFile=@PROJECT_DIR@/.env.ia
ExecStart=@PROJECT_DIR@/venv/bin/python3 -m src.scheduler_cli
Restart=always
RestartSec=10
TimeoutStopSec=30
KillSignal=SIGTERM

# Logs
StandardOutput=append:@PROJECT_DIR@/logs/scheduler.log
StandardError=append:@PROJECT_DIR@/logs/scheduler-error.log

[Install]
WantedBy=default.target
