[Unit]
Description=Agente Monitor - Bot Telegram interactivo (Phases 4-6)
Documentation=file:///home/monitor/agente-monitor/README_AGENT.md
After=default.target

[Service]
Type=simple
WorkingDirectory=/home/monitor/agente-monitor
Environment=CONFIG_PATH=config/config_ia.yaml
EnvironmentFile=/home/monitor/agente-monitor/.env.ia
ExecStart=/home/monitor/agente-monitor/venv/bin/python3 -m src.telegram_bot
Restart=always
RestartSec=10
TimeoutStopSec=30
KillSignal=SIGTERM

# Logs
StandardOutput=append:/home/monitor/agente-monitor/logs/bot.log
StandardError=append:/home/monitor/agente-monitor/logs/bot-error.log

[Install]
WantedBy=default.target
