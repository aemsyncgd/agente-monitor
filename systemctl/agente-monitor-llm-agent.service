[Unit]
Description=Agente Monitor - Agente LLM (Ollama / OpenRouter / Anthropic)
Documentation=file:///home/monitor/agente-monitor/README_AGENT.md
After=influxdb-ia.service
Wants=influxdb-ia.service

[Service]
Type=simple
WorkingDirectory=/home/monitor/agente-monitor
Environment=CONFIG_PATH=config/config_ia.yaml
EnvironmentFile=/home/monitor/agente-monitor/.env.ia
ExecStart=/home/monitor/agente-monitor/venv/bin/python3 -m src.ai.llm_agent.main
Restart=always
RestartSec=10
TimeoutStopSec=30
KillSignal=SIGTERM

# Logs
StandardOutput=append:/home/monitor/agente-monitor/logs/llm-agent.log
StandardError=append:/home/monitor/agente-monitor/logs/llm-agent-error.log

[Install]
WantedBy=default.target
