# .env - Variables de entorno del sistema de monitoreo
# IMPORTANTE: Este archivo contiene secretos. NUNCA commitearlo a repositorios.
# Copiar desde .env.example y completar los valores reales.

# === Zabbix (DEPRECATED — sera eliminado en futura version) ===
ZABBIX_API_URL=
ZABBIX_API_USER=
ZABBIX_API_PASS=

# === InfluxDB admin token (compose.yml) ===
# Token admin inicial de InfluxDB. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INFLUXDB_ADMIN_TOKEN=

# === Telegram ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === API Authentication ===
# API key para acceso admin (lectura + escritura). Obligatorio para proteger la API.
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# API key para acceso viewer (solo lectura). Opcional.
API_KEY_VIEWER=

# === Pantallas TV: acceso sin API key ===
# IPs o rangos CIDR (separados por coma) que pueden leer SOLO los endpoints de
# los dashboards TV (/backbone y /olts) SIN API key. El resto de /api/* sigue
# exigiendo API key. Vacio = desactivado. Ejemplo: TV_NOAUTH_IPS=10.0.4.6
TV_NOAUTH_IPS=
# Rol otorgado a esas IPs sin clave (viewer|operator|admin). viewer = solo lectura.
TV_NOAUTH_ROLE=viewer

# === CORS ===
# Origenes permitidos separados por coma (ej: http://localhost:8000,http://10.0.0.1:8000)
# Vacio = solo same-origin
ALLOWED_ORIGINS=

# === HSTS ===
# Habilitar solo si se usa HTTPS con certificado valido
ENABLE_HSTS=false

# === Config ===
CONFIG_PATH=config/config.yaml
