# .env.ia.example - Variables de entorno del sistema IA
# IMPORTANTE: Este archivo contiene secretos. NUNCA commitearlo a repositorios.
# Copiar desde .env.ia.example y completar los valores reales.

# === InfluxDB ===
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=
INFLUXDB_ORG=vidanet
INFLUXDB_BUCKET=monitoreo
INFLUXDB_PASSWORD=

# === Telegram ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === SNMP ===
# Community string para consultas SNMP a dispositivos de red
SNMP_COMMUNITY=

# === SSH (para verificacion de fallas) ===
SSH_USERNAME=
SSH_PASSWORD=

# === API Authentication ===
# API key para acceso admin (lectura + escritura). Obligatorio para proteger la API.
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# API key para acceso viewer (solo lectura). Opcional.
API_KEY_VIEWER=
# API key para acceso operator (lectura + configuración LLM). Opcional.
API_KEY_OPERATOR=

# === Pantallas TV: acceso sin API key ===
# IPs o rangos CIDR que pueden leer SOLO los endpoints de /backbone y /olts
# SIN API key. El resto de /api/* sigue exigiendo API key.
# Vacio = desactivado. Ejemplo: TV_NOAUTH_IPS=10.0.4.6
TV_NOAUTH_IPS=
# Rol otorgado a esas IPs sin clave (viewer|operator|admin). viewer = solo lectura.
TV_NOAUTH_ROLE=viewer

# === CORS ===
# Origenes permitidos separados por coma (ej: http://localhost:8000,http://10.0.0.1:8000)
# Vacio = solo same-origin
ALLOWED_ORIGINS=

# === HSTS ===
# Habilitar solo si se usa HTTPS con certificado valido
ENABLE_HSTS=false

# === API czwisp (Fuente 3 - base de datos de clientes) ===
# API key de czwisp (lectura). Obligatorio si se habilita wisp.
WISP_API_KEY=
# Slug del ISP en czwisp (ej: vidanet). Se configura en el panel de czwisp.
WISP_ISP_SLUG=
# Endpoint de listado masivo de clientes. Dejar vacío si no está disponible:
# en ese caso se usan lookup por documento + semilla CSV local.
WISP_LIST_ENDPOINT=/api/webhooks/cliente/{slug}/clientes
# Endpoint de lookup por documento (GET ?documento={doc}).
WISP_DOCUMENT_ENDPOINT=/api/webhooks/cliente/{slug}/cliente?documento={documento}
# Endpoint de lookup por serial ONU (GET ?onu={serial}).
WISP_SERIAL_ENDPOINT=/api/webhooks/cliente/{slug}/servicio?onu={serial}
# Semilla CSV con columnas documento,serial_onu,usuario_pppoe,nap,...
WISP_DOCUMENTOS_CSV=data/wisp_documentos.csv

# === Config ===
CONFIG_PATH=config/config_ia.yaml

# === OLT Web (VSOL) — respaldo para MAC por ONU (ver docs/olt_mac_snmp.md) ===
# Credenciales del panel web VSOL. Se usan como respaldo cuando SNMP no expone
# la tabla FDB privada. Dejar OLT_WEB_ENABLED=false para deshabilitar.
OLT_WEB_ENABLED=false
OLT_WEB_USER=root
OLT_WEB_PASSWORD=

# === Redis (ClientStore: cache de fichas de clientes) ===
# Opcional. Si Redis no esta disponible el sistema cae en consultas directas a
# InfluxDB (mas lentas) sin perder funcionalidad.
REDIS_URL=redis://localhost:6379/0

# === Rutas (opcionales; los scripts ya aplican estos defaults) ===
MODEL_PATH=models/optical_autoencoder.pt
NODES_PATH=config/nodes.yaml
PING_TARGETS_PATH=config/ping_targets.yaml
PROMETHEUS_PORT=9108
