# .env.ia.example - Variables de entorno del sistema IA
# IMPORTANTE: Este archivo contiene secretos. NUNCA commitearlo a repositorios.
# Copiar desde .env.ia.example y completar los valores reales.

# === InfluxDB ===
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=
INFLUXDB_ORG=vidanet
INFLUXDB_BUCKET=monitoreo
INFLUXDB_PASSWORD=

# === Telegram ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === SNMP ===
# Community string para consultas SNMP a dispositivos de red
SNMP_COMMUNITY=

# === SSH (para verificacion de fallas) ===
SSH_USERNAME=
SSH_PASSWORD=

# === API Authentication ===
# API key para acceso admin (lectura + escritura). Obligatorio para proteger la API.
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# API key para acceso viewer (solo lectura). Opcional.
API_KEY_VIEWER=
# API key para acceso operator (lectura + configuración LLM). Opcional.
API_KEY_OPERATOR=

# === CORS ===
# Origenes permitidos separados por coma (ej: http://localhost:8000,http://10.0.0.1:8000)
# Vacio = solo same-origin
ALLOWED_ORIGINS=

# === HSTS ===
# Habilitar solo si se usa HTTPS con certificado valido
ENABLE_HSTS=false

# === Config ===
CONFIG_PATH=config/config_ia.yaml
